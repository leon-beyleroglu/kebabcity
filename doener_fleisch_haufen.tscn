[sub_resource type="Shader" id="Shader_doener_meat"]
code = "shader_type spatial;
render_mode cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform float strip_seed = 1.0;
uniform float strip_length = 0.70;
uniform float strip_width = 0.22;
uniform float curl_intensity = 0.085;
uniform float edge_raggedness = 0.35;

uniform vec3 color_inner_cut : source_color = vec3(0.68, 0.50, 0.36);
uniform vec3 color_roasted : source_color = vec3(0.46, 0.22, 0.09);
uniform vec3 color_crispy_char : source_color = vec3(0.18, 0.06, 0.02);

varying float v_roast;
varying float v_edge;
varying float v_top_face;
varying vec2 v_meat_uv;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(
		mix(hash(i + vec2(0.0, 0.0)), hash(i + vec2(1.0, 0.0)), u.x),
		mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
		u.y
	);
}

float fbm(vec2 p) {
	float v = 0.0;
	float a = 0.5;
	for (int i = 0; i < 4; i++) {
		v += a * noise(p);
		p *= 2.15;
		a *= 0.5;
	}
	return v;
}

void vertex() {
	// Normierte Koordinaten entlang des Fleischstreifens:
	// u: 0.0 bis 1.0 über die Länge (X)
	// centered_v: -1.0 bis 1.0 über die Breite (Z)
	float u = clamp((VERTEX.x / strip_length) + 0.5, 0.0, 1.0);
	float centered_v = clamp(VERTEX.z / (strip_width * 0.5), -1.0, 1.0);
	float v = centered_v * 0.5 + 0.5;
	
	v_meat_uv = vec2(u, v);
	
	// Schmaler zulaufende Enden (wie mit dem Dönermesser geschnitten)
	float end_taper = sin(u * 3.14159265);
	end_taper = clamp(pow(max(0.001, end_taper), 0.45), 0.22, 1.0);
	
	// Ausgefranste, unregelmäßige Schnittkanten
	float edge_n = (noise(vec2(u * 4.5 + strip_seed * 7.1, v * 3.0 + strip_seed * 3.7)) - 0.5) * 2.0;
	float width_factor = end_taper * (1.0 + edge_n * edge_raggedness);
	
	// Ränder dünner machen (knusprige Kanten)
	float edge_thin = 1.0 - 0.55 * pow(abs(centered_v), 1.6);
	
	vec3 pos = VERTEX;
	pos.z *= width_factor;
	pos.y *= edge_thin;
	
	// Typische Wölbung von frisch geschnittenem Dönerfleisch (C-Rollung + Längswellen)
	float curl_dir = (fract(strip_seed * 0.73) > 0.5) ? 1.0 : -1.0;
	float c_cup = (centered_v * centered_v) * curl_intensity * 0.65 * curl_dir;
	float wave_l = sin(u * 3.14159265 * 2.3 + strip_seed * 4.1) * curl_intensity * 0.55;
	float arch_l = sin(u * 3.14159265) * curl_intensity * 0.6 * curl_dir;
	float detail_bump = (noise(vec2(u * 7.0 + strip_seed * 11.3, v * 7.0)) - 0.5) * curl_intensity * 0.55;
	
	float y_offset = c_cup + wave_l + arch_l + detail_bump;
	pos.y += y_offset;
	
	// Leichte Verdrehung (Twist) über die Länge des Streifens
	float twist_angle = (u - 0.5) * 0.65 * curl_dir;
	float cy = cos(twist_angle);
	float sy = sin(twist_angle);
	float rot_y = pos.y * cy - pos.z * sy;
	float rot_z = pos.y * sy + pos.z * cy;
	pos.y = rot_y;
	pos.z = rot_z;
	
	VERTEX = pos;
	
	// Oberseite = knusprig gegrillt, Unterseite = hellere Schnittfläche
	v_top_face = (NORMAL.y >= 0.0) ? 1.0 : 0.32;
	v_edge = clamp(abs(centered_v) * 0.85 + (1.0 - end_taper) * 0.5, 0.0, 1.0);
	v_roast = clamp(0.55 + (detail_bump / max(0.001, curl_intensity)) * 1.4 + v_edge * 0.35, 0.0, 1.0);
}

void fragment() {
	// Längliche Fleischfasern + Grillbläschen
	vec2 fiber_uv = vec2(v_meat_uv.x * 10.0 + strip_seed, v_meat_uv.y * 38.0);
	float fibers = fbm(fiber_uv);
	float sizzle_spots = fbm(v_meat_uv * 26.0 + vec2(strip_seed * 5.3));
	
	float roast_level = clamp(v_roast * v_top_face * 0.85 + sizzle_spots * 0.55 - 0.12, 0.0, 1.0);
	float crispy_edges = smoothstep(0.60, 0.90, roast_level + v_edge * 0.38);
	
	// Farbmischung: Saftige Schnittfläche -> Goldbraun geröstet -> Dunkle Kruste am Rand
	vec3 base_col = mix(color_inner_cut, color_roasted, smoothstep(0.12, 0.68, roast_level));
	base_col = mix(base_col, color_crispy_char, crispy_edges);
	base_col *= (0.84 + 0.32 * fibers);
	
	ALBEDO = base_col;
	ROUGHNESS = mix(0.24, 0.68, crispy_edges * 0.7 + (1.0 - fibers) * 0.3);
	SPECULAR = 0.65;
	NORMAL_MAP = normalize(vec3((fibers - 0.5) * 0.35, (sizzle_spots - 0.5) * 0.35, 1.0));
}
"

